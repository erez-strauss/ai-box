# LEGACY. Prefer the ~/.aikeys store: `ai-keys add default`.
# See docs/credentials.md. This file is only read by -a envfile,
# and env values are visible in `docker inspect`, unlike a mounted key file.
# Copy to ~/.config/ai-box/anthropic.env and chmod 600.
# Only needed for AI_BOX_AUTH=envfile. Leave unset when using OAuth login.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME

# Optional: drop non-essential outbound traffic (Datadog telemetry endpoints).
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1
